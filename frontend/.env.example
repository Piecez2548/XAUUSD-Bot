# Public frontend configuration only. Never put tokens or credentials here.
# Local development uses Vite's /api proxy when this is blank.
VITE_API_BASE_URL=
# Optional explicit websocket endpoint for a remotely reachable read-only API.
VITE_WS_URL=
# Set true only for a separate same-origin private build served by FastAPI
# behind tailnet-only Tailscale Serve. Leave unset for the public Vercel build.
VITE_PRIVATE_DASHBOARD=false
