# Optional exact broker symbol override. Required when discovery is ambiguous.
# TRADING_SYMBOL=XAUUSD

# Prefer leaving these unset to use the account already logged into MT5 Desktop.
# MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
# MT5_LOGIN=12345678
# MT5_SERVER=Broker-Server
# MT5_PASSWORD=replace-with-local-secret

CANDLES_M5=1000
CANDLES_M15=1000
CANDLES_H1=500
CANDLES_H4=500
MINIMUM_CANDLE_RATIO=0.8
LOG_LEVEL=INFO
LOG_DIRECTORY=logs

# Local-first persistence. Replace with a PostgreSQL SQLAlchemy URL in a future deployment.
DATABASE_URL=sqlite:///data/trading_observatory.db
BACKUP_DIRECTORY=backups

# Optional Telegram notifications. Secrets remain server-side.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=5

# Optional local Telegram control service. Disabled/deny-by-default.
TELEGRAM_CONTROL_ENABLED=false
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_CONTROL_POLL_SECONDS=5
TELEGRAM_CONTROL_RATE_LIMIT_SECONDS=3
SUPERVISOR_MAX_RESTARTS=3
SUPERVISOR_RESTART_WINDOW_SECONDS=600
SUPERVISOR_OPERATION_TIMEOUT_SECONDS=30

# Local API and permitted frontend origins.
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Read-only risk display policy. These values do not authorize or execute trades.
MAX_TRADE_RISK_PERCENT=2
MAX_AGGREGATE_RISK_PERCENT=6
SHADOW_ENGINE_ENABLED=true
SHADOW_STRATEGY=baseline_v1
SHADOW_DECISION_TIMEFRAME=M5
SHADOW_MIN_RR=2
SHADOW_MAX_SPREAD_POINTS=100
SHADOW_NOTIFY_SIGNALS=true
SHADOW_NOTIFY_NO_TRADE=false
SHADOW_OUTCOME_HORIZON_BARS=12
FORWARD_SHADOW_ENABLED=false
FORWARD_SHADOW_RR=2.0

# Continuous read-only Live Data Engine cadence and safety thresholds.
LIVE_TICK_INTERVAL_SECONDS=1
LIVE_ACCOUNT_INTERVAL_SECONDS=5
LIVE_CANDLE_INTERVAL_SECONDS=5
LIVE_HISTORY_INTERVAL_SECONDS=30
LIVE_CANDLE_LOOKBACK=100
LIVE_WEBSOCKET_TICK_THROTTLE_MS=500
MT5_RECONNECT_INITIAL_SECONDS=1
MT5_RECONNECT_MAX_SECONDS=30
DATA_STALE_TICK_SECONDS=10
DATA_STALE_ACCOUNT_SECONDS=30
DATA_STALE_POSITION_SECONDS=30
