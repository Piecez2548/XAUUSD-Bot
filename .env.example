# Optional exact broker symbol override. Required when discovery is ambiguous.
# TRADING_SYMBOL=XAUUSD

# Prefer leaving these unset to use the account already logged into MT5 Desktop.
# MT5_TERMINAL_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe
# MT5_AUTO_LAUNCH=false
# Opt-in: hide only the verified configured terminal64.exe top-level window on Windows.
# Window-hiding failure never changes MT5 connectivity/readiness.
MT5_BACKGROUND_MODE=false
# MT5_STARTUP_TIMEOUT_SECONDS=30
# MT5_LOGIN=12345678
# MT5_SERVER=Broker-Server
# MT5_PASSWORD=replace-with-local-secret

CANDLES_M5=1000
CANDLES_M15=1000
CANDLES_H1=500
CANDLES_H4=500
MINIMUM_CANDLE_RATIO=0.8
LOG_LEVEL=INFO
LOG_DIRECTORY=logs

# Local-first persistence. Replace with a PostgreSQL SQLAlchemy URL in a future deployment.
DATABASE_URL=sqlite:///data/trading_observatory.db
BACKUP_DIRECTORY=backups

# Optional Telegram notifications. Secrets remain server-side.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEOUT_SECONDS=5

# Optional local Telegram control service. Disabled/deny-by-default.
TELEGRAM_CONTROL_ENABLED=false
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_CONTROL_POLL_SECONDS=5
TELEGRAM_CONTROL_RATE_LIMIT_SECONDS=3
SUPERVISOR_MAX_RESTARTS=3
SUPERVISOR_RESTART_WINDOW_SECONDS=600
SUPERVISOR_OPERATION_TIMEOUT_SECONDS=30

# Local API and permitted frontend origins.
API_HOST=127.0.0.1
API_PORT=8000
# Explicitly enable only when FastAPI is behind tailnet-only Tailscale Serve.
# This requires the trusted Tailscale-User-Login identity header and applies
# the Phase 2.6 read-only route allowlist plus application-session checks.
# The private auth prototype has no remote user/bootstrap provisioning.
# Default: false.
REMOTE_DASHBOARD_MODE=false
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=12
AUTH_SESSION_TOUCH_SECONDS=60
# Exact browser origins allowed to perform private cookie-authenticated mutations.
# Set to private dashboard HTTPS origin(s), comma-separated, without paths.
# Empty/unset intentionally fails closed for private mutations.
CSRF_TRUSTED_ORIGINS=
# Production: set the exact HTTPS Vercel origin; never use *.
DASHBOARD_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Read-only risk display policy. These values do not authorize or execute trades.
MAX_TRADE_RISK_PERCENT=2
MAX_AGGREGATE_RISK_PERCENT=6
# Demo execution remains fail-closed unless explicitly enabled and armed
# through the authenticated Telegram control plane. Real-money execution has
# no enable path.
DEMO_EXECUTION_ENABLED=false
DEMO_EXECUTION_MAX_TICK_AGE_SECONDS=10
DEMO_EXECUTION_MAX_ENTRY_DEVIATION_POINTS=20
DEMO_EXECUTION_DEVIATION_POINTS=20
SHADOW_ENGINE_ENABLED=true
SHADOW_STRATEGY=baseline_v1
SHADOW_DECISION_TIMEFRAME=M5
SHADOW_MIN_RR=2
SHADOW_MAX_SPREAD_POINTS=100
SHADOW_NOTIFY_SIGNALS=true
SHADOW_NOTIFY_NO_TRADE=false
SHADOW_OUTCOME_HORIZON_BARS=12
FORWARD_SHADOW_ENABLED=false
FORWARD_SHADOW_RR=2.0

# Continuous read-only Live Data Engine cadence and safety thresholds.
LIVE_TICK_INTERVAL_SECONDS=1
LIVE_ACCOUNT_INTERVAL_SECONDS=5
LIVE_CANDLE_INTERVAL_SECONDS=5
LIVE_HISTORY_INTERVAL_SECONDS=30
LIVE_CANDLE_LOOKBACK=100
LIVE_WEBSOCKET_TICK_THROTTLE_MS=500
MT5_RECONNECT_INITIAL_SECONDS=1
MT5_RECONNECT_MAX_SECONDS=30
DATA_STALE_TICK_SECONDS=10
# Diagnostic-only threshold; does not change DATA_STALE_TICK_SECONDS.
TICK_DIAGNOSTIC_SLOW_SECONDS=2
DATA_STALE_ACCOUNT_SECONDS=30
DATA_STALE_POSITION_SECONDS=30
